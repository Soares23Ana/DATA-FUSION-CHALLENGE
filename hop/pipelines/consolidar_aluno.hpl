<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>consolidar_aluno</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Consolida por aluno: SQLite (acadêmico) + CSV (financeiro, chave CPF) + MongoDB (protocolos, chave RA)</description>
    <extended_description>Radar da Secretaria UNIFEOB - Desafio Data Fusion</extended_description>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>DIR_FONTES</name>
        <default_value>${PROJECT_HOME}/../fontes</default_value>
        <description>Pasta com academico.db e financeiro_mensalidades.csv</description>
      </parameter>
      <parameter>
        <name>DIR_STAGING</name>
        <default_value>${PROJECT_HOME}/../staging</default_value>
        <description>Pasta de saída (staging) lida pelo carregador do DuckDB</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/09 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/09 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>1) Acadêmico (SQLite): frequência, média e disciplinas em risco por aluno
2) Financeiro (CSV): CPF normalizado (só dígitos) e parcelas ATRASADAS agregadas
3) Protocolos (MongoDB): pipeline de agregação conta sinais de evasão e protocolos abertos por RA
4) Junções por CPF e por RA -> staging/aluno_consolidado_hop.csv -> DuckDB</note>
      <xloc>80</xloc>
      <yloc>500</yloc>
      <width>520</width>
      <heigth>90</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop><from>Acadêmico - SQLite</from><to>Junta financeiro (CPF)</to><enabled>Y</enabled></hop>
    <hop><from>Financeiro - CSV</from><to>Normaliza CPF</to><enabled>Y</enabled></hop>
    <hop><from>Normaliza CPF</from><to>Só parcelas atrasadas</to><enabled>Y</enabled></hop>
    <hop><from>Só parcelas atrasadas</from><to>Agrega financeiro por CPF</to><enabled>Y</enabled></hop>
    <hop><from>Agrega financeiro por CPF</from><to>Junta financeiro (CPF)</to><enabled>Y</enabled></hop>
    <hop><from>Junta financeiro (CPF)</from><to>Junta protocolos (RA)</to><enabled>Y</enabled></hop>
    <hop><from>Protocolos - MongoDB</from><to>Junta protocolos (RA)</to><enabled>Y</enabled></hop>
    <hop><from>Junta protocolos (RA)</from><to>Saída consolidada (staging)</to><enabled>Y</enabled></hop>
  </order>

  <transform>
    <name>Acadêmico - SQLite</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>academico_sqlite</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT a.ra, a.nome, a.cpf, c.nome AS curso, a.periodo, a.cep,
       ROUND(AVG(100.0 * (1.0 - CAST(m.faltas AS REAL) / m.aulas_dadas)), 1) AS frequencia_media,
       ROUND(AVG((m.nota_p1 + m.nota_p2) / 2.0), 2) AS media_geral,
       SUM(CASE WHEN (m.nota_p1 + m.nota_p2) / 2.0 &lt; 6
                  OR (1.0 - CAST(m.faltas AS REAL) / m.aulas_dadas) &lt; 0.75 THEN 1 ELSE 0 END) AS disciplinas_em_risco
FROM alunos a
JOIN cursos c ON c.id = a.curso_id
JOIN matriculas m ON m.ra = a.ra
WHERE a.situacao = 'ATIVO'
GROUP BY a.ra, a.nome, a.cpf, c.nome, a.periodo, a.cep</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>80</yloc></GUI>
  </transform>

  <transform>
    <name>Financeiro - CSV</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${DIR_FONTES}/financeiro_mensalidades.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>CPF_ALUNO</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>COMPETENCIA</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>VENCIMENTO</name><type>Date</type><format>dd/MM/yyyy</format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>VALOR</name><type>Number</type><format>#,##0.00</format><currency/><decimal>,</decimal><group>.</group><length>-1</length><precision>2</precision><trim_type>both</trim_type></field>
      <field><name>DATA_PAGAMENTO</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>STATUS</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>240</yloc></GUI>
  </transform>

  <transform>
    <name>Normaliza CPF</name>
    <type>ReplaceString</type>
    <description>123.456.789-00 -> 12345678900 (mesmo formato do sistema acadêmico)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <in_stream_name>CPF_ALUNO</in_stream_name>
        <out_stream_name>cpf</out_stream_name>
        <use_regex>yes</use_regex>
        <replace_string>[^0-9]</replace_string>
        <replace_by_string/>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>no</case_sensitive>
        <is_unicode>no</is_unicode>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>256</xloc><yloc>240</yloc></GUI>
  </transform>

  <transform>
    <name>Só parcelas atrasadas</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Agrega financeiro por CPF</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>STATUS</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>ATRASADO</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>432</xloc><yloc>240</yloc></GUI>
  </transform>

  <transform>
    <name>Agrega financeiro por CPF</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <give_back_row>N</give_back_row>
    <group>
      <field><name>cpf</name></field>
    </group>
    <fields>
      <field><aggregate>parcelas_atrasadas</aggregate><subject>cpf</subject><type>COUNT_ALL</type><valuefield/></field>
      <field><aggregate>valor_em_aberto</aggregate><subject>VALOR</subject><type>SUM</type><valuefield/></field>
    </fields>
    <attributes/>
    <GUI><xloc>608</xloc><yloc>240</yloc></GUI>
  </transform>

  <transform>
    <name>Protocolos - MongoDB</name>
    <type>MongoDbInput</type>
    <description>Pipeline de agregação: sinais de evasão e protocolos em aberto por RA</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>atendimentos_mongo</connection>
    <fields_name/>
    <collection>atendimentos</collection>
    <json_field_name>json</json_field_name>
    <json_query>[{"$group": {"_id": "$ra",
  "protocolos_sinal_evasao": {"$sum": {"$cond": [{"$in": ["$tipo", ["Trancamento de matrícula", "Cancelamento de matrícula", "Transferência externa", "Reclamação / ouvidoria"]]}, 1, 0]}},
  "protocolos_abertos": {"$sum": {"$cond": [{"$ne": ["$status", "CONCLUIDO"]}, 1, 0]}}}}]</json_query>
    <output_json>N</output_json>
    <query_is_pipeline>Y</query_is_pipeline>
    <execute_for_each_row>N</execute_for_each_row>
    <mongo_fields>
      <mongo_field><field_name>ra_mongo</field_name><field_path>$._id</field_path><field_type>String</field_type><indexed_vals/><field_array_index/><occur_fields/><field_disparate_types>N</field_disparate_types></mongo_field>
      <mongo_field><field_name>protocolos_sinal_evasao</field_name><field_path>$.protocolos_sinal_evasao</field_path><field_type>Integer</field_type><indexed_vals/><field_array_index/><occur_fields/><field_disparate_types>N</field_disparate_types></mongo_field>
      <mongo_field><field_name>protocolos_abertos</field_name><field_path>$.protocolos_abertos</field_path><field_type>Integer</field_type><indexed_vals/><field_array_index/><occur_fields/><field_disparate_types>N</field_disparate_types></mongo_field>
    </mongo_fields>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>400</yloc></GUI>
  </transform>

  <transform>
    <name>Junta financeiro (CPF)</name>
    <type>StreamLookup</type>
    <description>Acadêmico x Financeiro pela chave CPF</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>Agrega financeiro por CPF</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>cpf</name><field>cpf</field></key>
      <value><name>parcelas_atrasadas</name><rename>parcelas_atrasadas</rename><default>0</default><type>Integer</type></value>
      <value><name>valor_em_aberto</name><rename>valor_em_aberto</rename><default>0</default><type>Number</type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>608</xloc><yloc>80</yloc></GUI>
  </transform>

  <transform>
    <name>Junta protocolos (RA)</name>
    <type>StreamLookup</type>
    <description>Acadêmico x MongoDB pela chave RA</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>Protocolos - MongoDB</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>ra</name><field>ra_mongo</field></key>
      <value><name>protocolos_sinal_evasao</name><rename>protocolos_sinal_evasao</rename><default>0</default><type>Integer</type></value>
      <value><name>protocolos_abertos</name><rename>protocolos_abertos</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>784</xloc><yloc>80</yloc></GUI>
  </transform>

  <transform>
    <name>Saída consolidada (staging)</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${DIR_STAGING}/aluno_consolidado_hop</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
      <field><name>ra</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>nome</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>cpf</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>curso</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>periodo</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>cep</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>frequencia_media</name><type>Number</type><format>0.0</format><currency/><decimal>.</decimal><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>1</precision></field>
      <field><name>media_geral</name><type>Number</type><format>0.00</format><currency/><decimal>.</decimal><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>2</precision></field>
      <field><name>disciplinas_em_risco</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>parcelas_atrasadas</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>valor_em_aberto</name><type>Number</type><format>0.00</format><currency/><decimal>.</decimal><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>2</precision></field>
      <field><name>protocolos_sinal_evasao</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>protocolos_abertos</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
    </fields>
    <attributes/>
    <GUI><xloc>960</xloc><yloc>80</yloc></GUI>
  </transform>

  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
